# Brewfile - run with: brew bundle --file=./Brewfile
# This installs everything in one go.


# ---- Core CLI ----
brew "git"
brew "gh"                 # GitHub CLI
brew "neovim"
brew "tmux"
brew "wget"
brew "curl"
brew "openssh"

# ---- Modern CLI replacements ----
brew "eza"                # ls replacement
brew "bat"                # cat with syntax highlighting
brew "ripgrep"            # grep replacement (rg)
brew "fd"                 # find replacement
brew "fzf"                # fuzzy finder
brew "zoxide"             # smarter cd (z command)
brew "btop"               # process viewer
brew "jq"                 # JSON processor
brew "yq"                 # YAML processor
brew "tldr"               # practical command examples
brew "git-delta"          # better git diffs
brew "tree"

# ---- Shell ----
brew "starship"           # cross-shell prompt
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# ---- Languages / version managers ----
brew "mise"               # node/python/ruby/go version manager (asdf replacement)
brew "uv"                 # modern Python tooling (pip + venv + pyenv replacement)

# ---- Apps ----
cask "visual-studio-code"
cask "iterm2"             # or "ghostty" if you want to try the new hotness
cask "orbstack"           # docker desktop replacement, way faster on Apple Silicon
cask "raycast"            # spotlight replacement, huge productivity win
cask "rectangle"          # window snapping
cask "stats"              # menu bar system monitor
cask "postman"            # API client (or try "bruno" instead)

# ---- Fonts ----
cask "font-jetbrains-mono-nerd-font"
cask "font-meslo-lg-nerd-font"

