# ~/.gitconfig
# Update [user] section with your info before using

[user]
    name = Tommy Byrne
    email = tbyrn687@gmail.com

[init]
    defaultBranch = main

[core]
    editor = nvim
    pager = delta
    excludesfile = ~/.gitignore_global

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true
    side-by-side = true
    syntax-theme = Monokai Extended

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default

[pull]
    rebase = true

[push]
    default = simple
    autoSetupRemote = true

[fetch]
    prune = true

[rebase]
    autoStash = true
    autoSquash = true

[help]
    autocorrect = prompt

[color]
    ui = auto

[alias]
    s = status
    co = checkout
    br = branch
    cm = commit -m
    amend = commit --amend --no-edit
    last = log -1 HEAD
    unstage = reset HEAD --
    lg = log --oneline --graph --decorate --all
    wip = !git add -A && git commit -m 'WIP'
    undo = reset --soft HEAD~1
    cleanup = !git branch --merged main | grep -v 'main\\|master' | xargs -n 1 git branch -d
